{
  "name": "ai-agent-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal, explainable LLM agent starter: goal -> model chooses a tool -> backend validates and executes -> loop until a stop condition.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "exam:start": "node scripts/exam-start.js",
    "exam:model": "node scripts/exam-model.js",
    "exam:smoke": "node scripts/exam-smoke.js",
    "exam:rehearsal": "node scripts/exam-smoke.js --rehearsal",
    "exam:timer": "node scripts/exam-timer.js",
    "exam:report": "node scripts/exam-report.js",
    "test": "node --test tests/*.test.js",
    "eval": "node eval/run-eval.js",
    "eval:live": "node eval/run-eval.js --live",
    "smoke:live": "node scripts/smoke-live.js",
    "demo:datasets": "node scripts/demo-datasets.js",
    "demo:budgets": "node scripts/demo-budgets.js",
    "demo:proposals": "node scripts/demo-proposals.js",
    "qa:proposals": "node scripts/qa-proposals-browser.js",
    "qa:metrics": "node scripts/qa-metrics-browser.js",
    "qa:configuration": "node scripts/qa-configuration-browser.js"
  }
}
