# Copy to .env (never commit .env). Every value here is a placeholder.

# ── Model ────────────────────────────────────────────────────────────────
# mock              : built-in rule-based stand-in, no network, labelled MOCK in the UI.
# openai-compatible : any /chat/completions endpoint (Gemini, Ollama, vLLM, OpenAI).
MODEL_PROVIDER=mock

# Gemini (the provider the Final-Project team already uses).
#   Rate limits are applied per Google Cloud PROJECT, not per API key, and differ per model
#   (ai.google.dev/gemini-api/docs/rate-limits). A second key in the same project adds no quota.
#   Check your real limits in AI Studio, and verify every backup with `npm run smoke:live`.
#   MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL_NAME=gemini-2.5-flash
#   MODEL_API_KEY=<your Gemini key from Google AI Studio>
# Ollama on this machine (no key needed):
#   MODEL_BASE_URL=http://localhost:11434/v1/
#   MODEL_NAME=qwen3:8b
# Shared vLLM server from the course:
#   MODEL_BASE_URL=http://<server>:8000/v1/
MODEL_NAME=gemini-2.5-flash
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_API_KEY=

# Ask the endpoint for a JSON object (response_format=json_object). Set to false
# only if a server rejects that parameter; the backend validates either way.
MODEL_JSON_MODE=true
# Use "none" only for providers/models that support disabling reasoning (tested with Qwen3 on Ollama).
# Leave empty if the chosen endpoint rejects the option.
MODEL_REASONING_EFFORT=none
MODEL_TEMPERATURE=0
MODEL_MAX_OUTPUT_TOKENS=800

# ── Execution limits ─────────────────────────────────────────────────────
AGENT_MAX_STEPS=6
AGENT_MAX_REPAIRS=2
# Hard HTTP request limit per run (includes bounded retries; mock sends no HTTP).
AGENT_MAX_PROVIDER_REQUESTS=12
# Planning budget: validated provider usage + reservations for missing/failed usage.
# Input uses a UTF-8 byte heuristic, not a tokenizer or a billed-token guarantee.
AGENT_TOKEN_BUDGET=100000
MODEL_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=5000
RUN_MAX_MS=120000

# ── Server ───────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
